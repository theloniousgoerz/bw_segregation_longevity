	issn = {0038-0385, 1469-8684},
	shorttitle = {‘{Like} {Skydiving} without a {Parachute}’},
	url = {http://journals.sagepub.com/doi/10.1177/0038038516629917},
	doi = {10.1177/0038038516629917},
	abstract = {There is currently widespread concern that access to, and success within, the British acting profession is increasingly dominated by those from privileged class origins. This article seeks to empirically interrogate this claim using data on actors from the Great British Class Survey (N = 404) and 47 qualitative interviews. First, survey data demonstrate that actors from working-class origins are significantly underrepresented within the profession. Second, they indicate that even when those from working-class origins do enter the profession they do not have access to the same economic, cultural and social capital as those from privileged backgrounds. Third, and most significantly, qualitative interviews reveal how these capitals shape the way actors can respond to shared occupational challenges. In particular we demonstrate the profound occupational advantages afforded to actors who can draw upon familial economic resources, legitimate embodied markers of class origin (such as Received Pronunciation) and a favourable typecasting.},
	language = {en},
	number = {5},
	urldate = {2023-09-01},
	journal = {Sociology},
	author = {Friedman, Sam and O’Brien, Dave and Laurison, Daniel},
	month = oct,
	year = {2017},
	pages = {992--1010},
}

