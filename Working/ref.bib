@article{williams_marital_2004,
	title = {Marital {Status}, {Marital} {Transitions}, and {Health}: {A} {Gendered} {Life} {Course} {Perspective}},
	volume = {45},
	issn = {0022-1465},
	shorttitle = {Marital {Status}, {Marital} {Transitions}, and {Health}},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4061612/},
	abstract = {We work from a life course perspective to assess the impact of marital status and marital transitions on subsequent changes in the self-assessed physical health of men and women. Our results suggest three central conclusions regarding the association of marital status and marital transitions with self-assessed health. First, marital status differences in health appear to reflect the strains of marital dissolution more than they reflect any benefits of marriage. Second, the strains of marital dissolution undermine the self-assessed health of men but not women. Finally, life course stage is as important as gender in moderating the effects of marital status and marital transitions on health.},
	number = {1},
	urldate = {2024-06-13},
	journal = {Journal of health and social behavior},
	author = {Williams, Kristi and Umberson, Debra},
