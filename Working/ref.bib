@misc{reed_adolescents_2023,
	title = {Do {Adolescents} {Know} {What} {Their} {Parents} {Do}? {Knowledge} {About} {Parents}’ {Occupations} in the {Context} of {Occupational} {Reproduction}},
	shorttitle = {Hiring as {Cultural} {Matching}},
	url = {http://journals.sagepub.com/doi/10.1177/0003122412463213},
	doi = {10.1177/0003122412463213},
	abstract = {This study will address the longstanding question of why children frequently replicate their parents’ positions in the labor market. Rooted in the intergenerational transmission of occupational knowledge, the research investigates adolescents’ comprehension of their parents’ occupations and how this understanding inﬂuences their own occupational mobility. By leveraging natural language processing (NLP) techniques on verbatim descriptions of occupations from the Educational Longitudinal Study (ELS), I quantiﬁed the similarity between parents’ and adolescents’ descriptions of their parents’ occupation using cosine similarity estimates. The outcomes shed light on whether a clearer understanding of parental occupations encourages occupational reproduction due to transferred values, tastes, and preferences, or fosters a wider occupational awareness, potentially reducing the likelihood of occupational reproduction. Preliminary results suggest nuanced relationships between parental inﬂuence, adolescent understanding, and eventual occupational choices, underscoring the intricate web of factors shaping career trajectories.},
	language = {en},
	urldate = {2023-10-25},
	author = {Reed, Cody},
	year = {2023},
}

@article{reardon_has_2018,
	title = {Has {Income} {Segregation} {Really} {Increased}? {Bias} and {Bias} {Correction} in {Sample}-{Based} {Segregation} {Estimates}},
	volume = {55},
	issn = {1533-7790},
	shorttitle = {Has {Income} {Segregation} {Really} {Increased}?},
	url = {https://doi.org/10.1007/s13524-018-0721-4},
	doi = {10.1007/s13524-018-0721-4},
	abstract = {Several recent studies have concluded that residential segregation by income in the United States has increased in the decades since 1970, including a significant increase after 2000. Income segregation measures, however, are biased upward when based on sample data. This is a potential concern because the sampling rate of the American Community Survey (ACS)—from which post-2000 income segregation estimates are constructed—was lower than that of the earlier decennial censuses. Thus, the apparent increase in income segregation post-2000 may simply reflect larger upward bias in the estimates from the ACS, and the estimated trend may therefore be inaccurate. In this study, we first derive formulas describing the approximate sampling bias in two measures of segregation. Next, using Monte Carlo simulations, we show that the bias-corrected estimators eliminate virtually all of the bias in segregation estimates in most cases of practical interest, although the correction fails to eliminate bias in some cases when the population is unevenly distributed among geographic units and the average within-unit samples are very small. We then use the bias-corrected estimators to produce unbiased estimates of the trends in income segregation over the last four decades in large U.S. metropolitan areas. Using these corrected estimates, we replicate the central analyses in four prior studies on income segregation. We find that the primary conclusions from these studies remain unchanged, although the true increase in income segregation among families after 2000 was only half as large as that reported in earlier work. Despite this revision, our replications confirm that income segregation has increased sharply in recent decades among families with children and that income inequality is a strong and consistent predictor of income segregation.},
	language = {en},
	number = {6},
	urldate = {2023-10-23},
	journal = {Demography},
	author = {Reardon, Sean F. and Bischoff, Kendra and Owens, Ann and Townsend, Joseph B.},
	month = dec,
	year = {2018},
	keywords = {Income segregation, Residential segregation, Sampling bias, Segregation methodology, Spatial inequality},
	pages = {2129--2160},
}

