	issn = {1573-188X},
	shorttitle = {Latent {Postsecondary} {Persistence} {Pathways}},
	url = {https://doi.org/10.1007/s11162-007-9083-2},
	doi = {10.1007/s11162-007-9083-2},
	abstract = {Latent trajectories of credit hour accumulation were modeled using three independent samples of community college students. Five qualitatively distinct patterns of persistence emerged from these samples: Full-time, long-term; 2 years and out; long-term decliners; part-time, long-term; and one term and out. Follow-up analyses using measures on the Community College Student Report indicated that long-term decliner group; the part-time, long-term group; and the one term and out-group were less engaged than full-time students. In particular, the long-term decliner group was the least engaged group. The models illustrate the utility of latent trajectory modeling in higher education research and provide the basis for an empirically based typology of postsecondary persistence pathways.},
	language = {en},
	number = {4},
	urldate = {2022-07-11},
