@article{davis_narrative_2012,
	title = {Narrative {Construction} of a {Ruptured} {Self}: {Stories} of {Transability} on {Transabled}.org},
	volume = {55},
	issn = {0731-1214, 1533-8673},
	shorttitle = {Narrative {Construction} of a {Ruptured} {Self}},
	url = {http://journals.sagepub.com/doi/10.1525/sop.2012.55.2.319},
	doi = {10.1525/sop.2012.55.2.319},
	abstract = {Transabled.org is an online community for people with body integrity identity disorder (BIID). People with BIID believe that they were born in incorrectly abled bodies. By analyzing the Introduction statements of twenty-two bloggers, the author shows how BIID is collectively constructed and individually articulated. Specifically, the author shows how bloggers essentialize their impairment-needs, painting a picture of a ruptured self. Through self-narratives, bloggers describe their impairment-needs as existential and deeply intrinsic. They support this description in several ways: (1) focusing on childhood, (2) grappling with “why?”, (3) painting a detailed picture of the “correct” body, and (4) denial/surrender stories. The author argues that the essentialist narrative locates impairment-needs within a “natural” frame and in doing so acts as a form of moral stigma resistance. The author then connects this stigma management strategy with the political and material goals of medical recognition and a path to legal ability re-assignment surgery.},
	language = {en},
	number = {2},
	urldate = {2020-04-07},
	journal = {Sociological Perspectives},
	author = {Davis, Jenny L.},
	month = jun,
	year = {2012},
	pages = {319--340},
}

