	publisher = {MDPI AG},
	author = {Tehrani, Shadi O. and Wu, Shuling J. and Roberts, Jennifer D.},
	year = {2019},
	note = {Place: Basel, Switzerland, Basel},
	keywords = {physical and mental health outcomes, residential segregation, social determinants of health, transit-induced gentrification, transit-oriented development},
}

@article{rigolon_toward_2019,
	title = {Toward a socioecological model of gentrification: {How} people, place, and policy shape neighborhood change},
	volume = {41},
