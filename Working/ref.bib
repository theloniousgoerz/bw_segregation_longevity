@article{becker_manipulation_2016,
	title = {The {Manipulation} of {Children}’s {Preferences}, {Old}-{Age} {Support}, and {Investment} in {Children}’s {Human} {Capital}},
	copyright = {© 2016 by The University of Chicago. All rights reserved.},
	issn = {0734-306X},
	url = {https://www.journals.uchicago.edu/doi/10.1086/683778},
	doi = {10.1086/683778},
	abstract = {We consider the link between parents’ influence over the preferences of children, parental investments in children’s human capital, and children’s support of elderly parents. It may pay for parents to spend resources to “manipulate” children’s preferences in order to induce them to support their parents in old age. Since parents invest more in children when they expect greater support, manipulation of child preferences may end up helping children and parents. A new result, which we call the “Rotten Parent Theorem,” demonstrates that if children are altruistic, then even selfish parents will make the optimal investment in their children’s human capital.},
	language = {en},
	urldate = {2026-01-15},
	journal = {Journal of Labor Economics},
	publisher = {University of Chicago PressChicago, IL},
	author = {Becker, Gary S. and Murphy, Kevin M. and Spenkuch, Jörg L.},
	month = apr,
	year = {2016},
}

