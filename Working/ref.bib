@article{cantoni_does_2022,
	title = {Does {Context} {Outweigh} {Individual} {Characteristics} in {Driving} {Voting} {Behavior}? {Evidence} from {Relocations} within the {United} {States}},
	volume = {112},
	issn = {0002-8282},
	shorttitle = {Does {Context} {Outweigh} {Individual} {Characteristics} in {Driving} {Voting} {Behavior}?},
	url = {https://pubs.aeaweb.org/doi/10.1257/aer.20201660},
	doi = {10.1257/aer.20201660},
	abstract = {We measure the overall influence of contextual versus individual factors (e.g., voting rules and media as opposed to race and education) on voter behavior, and explore underlying mechanisms. Using a US-wide voter-level panel, 2008–2018, we examine voters who relocate across state and county lines, tracking changes in registration, turnout, and party affiliation to estimate location and individual fixed effects in a value-added model. Location explains 37 percent of the cross-state variation in turnout (to 63 percent for individual characteristics) and an only slightly smaller share of variation in party affiliation. Place effects are larger for young and White voters. (JEL D12, D72, I20, J15, L82, R23)},
	language = {en},
	number = {4},
	urldate = {2026-02-04},
	journal = {American Economic Review},
	author = {Cantoni, Enrico and Pons, Vincent},
	month = apr,
	year = {2022},
	pages = {1226--1272},
}

