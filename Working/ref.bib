@article{gailey_health_nodate,
	title = {Health selection into neighborhood greenspace among a highly mobile and},
	abstract = {Global urbanization has sparked substantial research on the importance of conserving and propagating natural environments. A large subset of this work focuses on the benefits of greenspace for health. An often-overlooked methodological concern when examining relations between greenspace and health – particularly in cross-sectional studies, which predominate the literature – involves residential self-selection. Unmeasured individual characteristics may precede both moves to greener neighborhoods and better health outcomes, biasing associations. However, few studies aim to observe residential selection patterns or estimate the magnitude of potential selfselection bias in the context of greenspace and health. To quantify the extent of this bias, this study used a longitudinal sibling comparison design with repeated individual and neighborhood measures to estimate associations between pre-move sociodemographic and health factors, including maternal body mass index (BMI) and infant birthweight, and post-move neighborhood greenspace in a residentially mobile sample of mothers in California, 2007 to 2015 (n=288,333). Results show that higher socioeconomic status (SES) and better health before moving predicted higher levels of neighborhood greenspace after moving, providing evidence of social and health selection. Findings also indicate some support for differential health-based selection into neighborhood greenspace by race/ethnicity. However, weak relations between premove individual factors and post-move greenspace across analyses suggest that potential bias due to residential self-selection appears relatively minimal in a large, diverse, and highly mobile sample of families in California.},
	language = {en},
	author = {Gailey, Samantha},
	pages = {35},
}

@article{chen_going_2018,
