@article{zavisca_socioeconomic_2016,
	title = {The {Socioeconomic}, {Demographic}, and {Political} {Effects} of {Housing} in {Comparative} {Perspective}},
	volume = {42},
	issn = {0360-0572, 1545-2115},
	url = {http://www.annualreviews.org/doi/10.1146/annurev-soc-081715-074333},
	doi = {10.1146/annurev-soc-081715-074333},
	abstract = {Few sociologists treat housing as a key independent variable, despite the emergence of disparate bodies of research analyzing how housing affects outcomes that traditionally interest sociologists. Scholars across the social sciences have proposed and tested mechanisms whereby housing could shape subjective well-being, socioeconomic status, demography, and politics. We review the evidence for causal effects across these domains. Next, we make recommendations for research designs to advance this literature. Most studies only test effects of homeownership, and most are focused on the United States and Western Europe. The evidence for causation is often weak, although studies increasingly employ complex techniques for identifying effects. Throughout, we emphasize studies beyond the United States, and we conclude by discussing distinctive insights yielded by comparative research. We advocate for a comparative perspective and more expansive conceptualization of housing status as a means to build theory and evidence regarding the conditions under which housing exerts effects.},
	language = {en},
	number = {1},
	urldate = {2021-08-31},
	journal = {Annual Review of Sociology},
	author = {Zavisca, Jane R. and Gerber, Theodore P.},
	month = jul,
	year = {2016},
	pages = {347--367},
}

@article{zuk_gentrification_2018,
	title = {Gentrification, {Displacement}, and the {Role} of {Public} {Investment}},
