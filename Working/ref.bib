@article{spader_can_2021,
	title = {Can {Changing} {Demographics} or {Refinancing} {Behaviors} {Explain} the {Rising} {Levels} of {Housing} {Debt} {Among} {Older} {Americans}?},
	volume = {31},
	issn = {1051-1482},
	url = {https://doi.org/10.1080/10511482.2020.1810098},
