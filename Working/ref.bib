}

@article{marescot_complex_2013,
	title = {Complex decisions made simple: a primer on stochastic dynamic programming},
	volume = {4},
	issn = {2041-210X},
	shorttitle = {Complex decisions made simple},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1111/2041-210X.12082},
	doi = {10.1111/2041-210X.12082},
	abstract = {Under increasing environmental and financial constraints, ecologists are faced with making decisions about dynamic and uncertain biological systems. To do so, stochastic dynamic programming (SDP) is the most relevant tool for determining an optimal sequence of decisions over time. Despite an increasing number of applications in ecology, SDP still suffers from a lack of widespread understanding. The required mathematical and programming knowledge as well as the absence of introductory material provide plausible explanations for this. Here, we fill this gap by explaining the main concepts of SDP and providing useful guidelines to implement this technique, including R code. We illustrate each step of SDP required to derive an optimal strategy using a wildlife management problem of the French wolf population. Stochastic dynamic programming is a powerful technique to make decisions in presence of uncertainty about biological stochastic systems changing through time. We hope this review will provide an entry point into the technical literature about SDP and will improve its application in ecology.},
	language = {en},
	number = {9},
	urldate = {2022-02-04},
	journal = {Methods in Ecology and Evolution},
	author = {Marescot, Lucile and Chapron, Guillaume and Chadès, Iadine and Fackler, Paul L. and Duchamp, Christophe and Marboutin, Eric and Gimenez, Olivier},
	year = {2013},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1111/2041-210X.12082},
	keywords = {Canis lupus, decision-making techniques, markov decision process, notion, optimization methods, stochastic dynamic programming},
	pages = {872--884},
}

@article{tyndall_local_2021,
	title = {The local labour market effects of light rail transit},
	volume = {124},
	issn = {0094-1190},
	url = {https://www.sciencedirect.com/science/article/pii/S0094119021000322},
	doi = {10.1016/j.jue.2021.103350},
	abstract = {Many US cities have made large investments in light rail transit in order to improve commuting networks. I analyse the labour market effects of light rail in four US metros. I propose a new instrumental variable to overcome endogeneity in transit station location, enabling causal identification of neighbourhood effects. Light rail stations are found to drastically improve employment outcomes in the surrounding neighbourhood. To incorporate endogenous sorting by workers, I estimate a structural neighbourhood choice model. Light rail systems tend to raise rents in accessible locations, displacing lower skilled workers to isolated neighbourhoods, which reduces aggregate metropolitan employment in equilibrium.},
	language = {en},
	urldate = {2021-09-21},
	journal = {Journal of Urban Economics},
