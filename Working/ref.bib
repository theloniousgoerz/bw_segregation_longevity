@article{mcclure_housing_2015,
	title = {Housing {Programs} {Fail} to {Deliver} on {Neighborhood} {Quality}, {Reexamined}},
	volume = {25},
	issn = {1051-1482},
	url = {https://doi.org/10.1080/10511482.2014.944201},
	doi = {10.1080/10511482.2014.944201},
	abstract = {This article revisits the relative performance of housing programs in terms of delivering on neighborhood quality. Newman and Schnare examined this issue in 1997, and this article updates their work more than a decade later. Both efforts examine the neighborhood characteristics surrounding assisted rental housing and assess the direction of assisted-housing policy. The analysis is performed by exploring census data at the tract level for the tenant-based Housing Choice Voucher program plus a set of project-based programs, including public housing, the Low-Income Housing Tax Credit program, and other HUD multifamily programs. We conclude that Newman and Schnare remain correct that rental housing assistance does little to improve the quality of the recipients' neighborhoods relative to those of welfare households and can make things worse. However, things have improved. The Housing Choice Voucher and Low-Income Housing Tax Credit programs have grown in importance over the intervening years and have improved their performance by moving more households into low-poverty, less distressed areas. Importantly, these active programs for assisted housing are beginning to find ways to overcome the barriers preventing entry into the suburbs, although more needs to be done.},
	number = {3},
	urldate = {2021-09-07},
	journal = {Housing Policy Debate},
	publisher = {Routledge},
	author = {McClure, Kirk and Johnson, Bonnie},
	month = jul,
	year = {2015},
	note = {\_eprint: https://doi.org/10.1080/10511482.2014.944201},
	keywords = {low-income housing, mobility, neighborhood},
	pages = {463--496},
}

