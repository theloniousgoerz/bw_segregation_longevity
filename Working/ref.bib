@article{wang_housing_2026,
	title = {Housing {Insecurity}, {Incident} {Geriatric} {Conditions}, and {Mortality} in {Community}-{Living} {Older} {Persons}},
	volume = {9},
	issn = {2574-3805},
	shorttitle = {Housing {Insecurity} and {Mortality} in {Older} {Persons}},
	url = {https://doi.org/10.1001/jamanetworkopen.2026.9335},
	doi = {10.1001/jamanetworkopen.2026.9335},
	abstract = {This prospective cohort study of 7,499 community-living Medicare beneficiaries aged 65 and older in the National Health and Aging Trends Study (2015-2020) examines whether housing insecurity, measured as both housing cost burden and interviewer-observed poor housing quality, predicts incident geriatric conditions and mortality. Housing cost burden (30 percent or more of income) was associated with increased risk of frailty (RRR 1.23), disability (RRR 1.24), dementia (RRR 1.37), and all-cause mortality (HR 1.51). Independently of cost burden, interviewer-observed poor housing quality, assessed with an environmental checklist of interior indicators (peeling paint, pests, broken furniture, flooring in disrepair, tripping hazards) and exterior indicators (broken windows, crumbling foundations, missing bricks, roof problems, uneven surfaces), was associated with frailty (RRR 1.30; 95\% CI, 1.04-1.62), disability (RRR 1.33; 95\% CI, 1.13-1.57), and mortality (HR 1.15; 95\% CI, 1.01-1.32), with no independent association with dementia. The authors conclude that housing insecurity should be recognized as a clinically relevant social determinant of health in older persons.},
	language = {en},
	number = {5},
	urldate = {2026-07-13},
	journal = {JAMA Network Open},
	author = {Wang, Yi and Davis-Plourde, Kendra and Vander Wyk, Brent},
	year = {2026},
	pages = {e269335},
}

@article{evans_residential_2024,
	title = {Residential {Immobility} and {Racial} and {Ethnic} {Disparities} in {Housing} {Quality}},
	volume = {10},
	issn = {2332-6492},
	url = {https://doi.org/10.1177/23326492231207603},
	doi = {10.1177/23326492231207603},
	abstract = {Black and Hispanic households live in lower-quality housing than White and Asian households. This study examines residential immobility as a mechanism sustaining these disparities. While residential mobility and socioeconomic status improve housing quality outcomes, Black and Hispanic households are significantly more likely than White households to be residentially immobile, and among the immobile population Black and Hispanic households have higher probabilities of living in lower-quality housing than White households. Housing quality disparities therefore persist in part because the households in the worst housing are least able to exit it.},
	language = {en},
	number = {1},
	urldate = {2026-07-13},
	journal = {Sociology of Race and Ethnicity},
	publisher = {SAGE Publications Inc},
	author = {Evans, Megan and Chapman, Alexander},
	year = {2024},
	pages = {31--50},
}

@article{hoffman_effects_2020,
	title = {The {Effects} of {Historical} {Housing} {Policies} on {Resident} {Exposure} to {Intra}-{Urban} {Heat}: {A} {Study} of 108 {US} {Urban} {Areas}},
	volume = {8},
	issn = {2225-1154},
	shorttitle = {The {Effects} of {Historical} {Housing} {Policies} on {Resident} {Exposure} to {Intra}-{Urban} {Heat}},
	url = {https://doi.org/10.3390/cli8010012},
	doi = {10.3390/cli8010012},
	abstract = {This study examines the relationship between the 1930s Home Owners' Loan Corporation (HOLC) redlining maps and present-day summertime intra-urban land surface temperature anomalies across 108 US urban areas. The authors find that 94 percent of studied areas display consistent city-scale patterns of elevated land surface temperatures in formerly redlined neighborhoods relative to their non-redlined neighbors, by as much as 7 degrees Celsius. Nationally, land surface temperatures in redlined areas average approximately 2.6 degrees Celsius warmer than in non-redlined areas, with the largest disparities in the Southeast and West. These patterns are partly attributable to the relative preponderance of impervious land cover to tree canopy in formerly redlined neighborhoods. The authors conclude that historical housing policies may be directly responsible for disproportionate exposure to current heat events.},
	language = {en},
	number = {1},
	urldate = {2026-07-13},
	journal = {Climate},
	publisher = {MDPI},
	author = {Hoffman, Jeremy S. and Shandas, Vivek and Pendleton, Nicholas},
	year = {2020},
	pages = {12},
}

@article{browning_neighborhood_2006,
	title = {Neighborhood {Social} {Processes}, {Physical} {Conditions}, and {Disaster}-{Related} {Mortality}: {The} {Case} of the 1995 {Chicago} {Heat} {Wave}},
	volume = {71},
	issn = {0003-1224},
	shorttitle = {Neighborhood {Social} {Processes}, {Physical} {Conditions}, and {Disaster}-{Related} {Mortality}},
	url = {https://doi.org/10.1177/000312240607100407},
	doi = {10.1177/000312240607100407},
	abstract = {This study examines the neighborhood-level determinants of mortality during the 1995 Chicago heat wave, which killed over 700 people, disproportionately older adults. The authors find that commercial decline in a neighborhood is positively associated with heat wave mortality and accounts for the protective effect of neighborhood affluence: where commercial activity remained robust, neighborhoods experienced substantially lower heat-related death rates. Notably, social network interaction and collective efficacy offered no protective effect during the acute crisis, although collective efficacy did reduce mortality during comparison periods in normal Julys. The findings indicate that the deteriorated physical and commercial conditions of disadvantaged neighborhoods, rather than social cohesion alone, drive excess mortality among vulnerable older residents during environmental shocks.},
	language = {en},
	number = {4},
	urldate = {2026-07-13},
	journal = {American Sociological Review},
	publisher = {SAGE Publications Inc},
	author = {Browning, Christopher R. and Wallace, Danielle and Feinberg, Seth L. and Cagney, Kathleen A.},
	year = {2006},
	pages = {661--678},
}

