@article{waters_segmented_2010,
	title = {Segmented assimilation revisited: types of acculturation and socioeconomic mobility in young adulthood},
	volume = {33},
	issn = {0141-9870, 1466-4356},
	shorttitle = {Segmented assimilation revisited},
	url = {http://www.tandfonline.com/doi/abs/10.1080/01419871003624076},
	doi = {10.1080/01419871003624076},
	abstract = {This article examines the debate between key theories of immigrant assimilation by exploring the effect of acculturation types Á dissonant, consonant and selective Á on socioeconomic outcomes in young adulthood. Drawing on survey data from the Immigrant Second Generation in Metropolitan New York, we show that, while all three types occur, dissonant acculturation is the exception, not the norm, among secondgeneration young adults. Our results also suggest that neither the type of acculturation nor the level of ethnic embeddedness can account for the variation in mobility patterns both across and within second-generation groups. These findings lead us to question assumptions about the protective effect of selective acculturation and the negative effect of dissonant acculturation.},
