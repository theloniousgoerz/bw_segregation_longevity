	keywords = {Adolescent, Adult, Age Factors, China, Economic reform, Female, Humans, Male, Marriage, Marriage entry, Socioeconomic determinants, Surveys and Questionnaires, Urban Population, Young Adult},
	pages = {1869--1892},
}

